# 环境变量示例：可安全提交；真实凭据仅保存于被 Git 忽略的 .env 或部署平台环境变量。
# npm run setup 仅在 .env 不存在时复制本文件并生成本地认证、Cron、加密密钥，不覆盖已有 .env。
# 功能开关默认关闭。完成各模块配置与实际验收后再启用；配置齐全不等于对接成功。

# 默认值：http://localhost:3000；何时必填：所有环境，生产必须改为本站真实 HTTPS 根地址。
# 用途：认证、事务邮件回跳、支付回跳、邀请链接和 SEO 的公开网站来源地址，不含路径、查询或凭据。
# 获取/生成：本地使用默认值；部署后填写分配的 HTTPS 域名或已绑定的自有域名。
APP_BASE_URL=http://localhost:3000
# 默认值：本机 5432 的独立 saas_framework 数据库；何时必填：所有数据库功能和迁移。
# 用途：服务端私密 PostgreSQL 连接串，格式 postgresql://账号:密码@主机:端口/数据库。
# 获取/生成：本地 npm run db:local:up 为专用账号生成密码并写入 .env；线上从数据库服务复制独立库连接串。
DATABASE_URL=postgresql://saas_framework:saas_framework@127.0.0.1:5432/saas_framework
# 默认值：空；何时必填：启动认证系统前，本地和生产均需独立密钥。
# 用途：服务端私密认证密钥，也用于签名邀请归因 Cookie；不要发送到浏览器或日志。
# 获取/生成：首次 npm run setup 生成本地值；生产使用加密安全随机数生成 32 字节并编码为 Base64URL。
BETTER_AUTH_SECRET=

# 默认值：false（本地）；何时必填：公开生产注册/登录前必须设为 true 并配齐下面三项。
# 用途：服务端功能开关，保护注册、登录和找回密码请求；人机挑战不证明邮箱归属。
# 获取/生成：在 Cloudflare Turnstile 为本站建立独立 Widget，配置与验收通过后手动启用。
FEATURE_TURNSTILE=false
# 默认值：空；何时必填：FEATURE_TURNSTILE=true。
# 用途：可公开给浏览器的 Turnstile Site Key，用于展示人机挑战组件。
# 获取/生成：Cloudflare Turnstile 的本站 Widget 中复制 Site Key；官方测试 Key 仅用于本地测试。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 默认值：空；何时必填：FEATURE_TURNSTILE=true。
# 用途：服务端私密 Turnstile Secret Key，用于调用 Siteverify；必须与 Site Key 属于同一 Widget。
# 获取/生成：从同一 Cloudflare Turnstile Widget 复制 Secret Key；生产不能使用官方测试 Key。
TURNSTILE_SECRET_KEY=
# 默认值：空；何时必填：FEATURE_TURNSTILE=true，包括本地启用测试时。
# 用途：非密钥，服务器核对 Siteverify 的 hostname；使用逗号分隔主机名，不带协议、路径或端口。
# 获取/生成：按本站实际访问主机填写，如本地 localhost,127.0.0.1；生产应与 Widget 的域名限制一致。
TURNSTILE_ALLOWED_HOSTNAMES=

# 默认值：false；何时必填：Google 登录按钮在真实浏览器中走通后按需设为 true。
# 用途：服务端功能开关，启用「使用 Google 登录」；须同时配齐下面两项，缺一即退回邮箱密码登录。
# 获取/生成：在 Google Cloud Console 建立 OAuth 2.0 客户端并配置回调地址后手动启用；未验收保持 false。
FEATURE_GOOGLE_OAUTH=false
# 默认值：空；何时必填：FEATURE_GOOGLE_OAUTH=true。
# 用途：非密钥的 Google OAuth 客户端 ID，会随授权请求出现在浏览器地址栏。
# 获取/生成：从 Google Cloud Console 的 OAuth 2.0 客户端复制 Client ID；回调地址填 APP_BASE_URL 加 /api/auth/callback/google。
GOOGLE_CLIENT_ID=
# 默认值：空；何时必填：FEATURE_GOOGLE_OAUTH=true。
# 用途：服务端私密 Google OAuth 客户端密钥，用于换取访问令牌；不要发送到浏览器或日志。
# 获取/生成：从同一 OAuth 2.0 客户端复制 Client Secret；重新生成后必须同步更新部署环境。
GOOGLE_CLIENT_SECRET=
# 默认值：false；何时必填：GitHub 登录按钮在真实浏览器中走通后按需设为 true。
# 用途：服务端功能开关，启用「使用 GitHub 登录」；须同时配齐下面两项，缺一即退回邮箱密码登录。
# 获取/生成：在 GitHub 的 Developer settings 建立 OAuth App 并配置回调地址后手动启用；未验收保持 false。
FEATURE_GITHUB_OAUTH=false
# 默认值：空；何时必填：FEATURE_GITHUB_OAUTH=true。
# 用途：非密钥的 GitHub OAuth App Client ID，会随授权请求出现在浏览器地址栏。
# 获取/生成：从 GitHub OAuth App 页面复制 Client ID；回调地址填 APP_BASE_URL 加 /api/auth/callback/github。
GITHUB_CLIENT_ID=
# 默认值：空；何时必填：FEATURE_GITHUB_OAUTH=true。
# 用途：服务端私密 GitHub OAuth App Client Secret，用于换取访问令牌；不要发送到浏览器或日志。
# 获取/生成：在 GitHub OAuth App 页面生成并复制 Client Secret；只在生成时可见一次，需立即安全保存。
GITHUB_CLIENT_SECRET=

# 默认值：false；何时必填：Payment Center 网站绑定、商品目录、回调和权益开通验收后按需设为 true。
# 用途：服务端统一收款开关；Stripe、人工、链上和佣金余额的订单及付款事实由 Payment Center 负责。
# 获取/生成：使用本站独立网站、最小权限 Key 和签名密钥完成真实联调；本地可用不代表生产已连接。
FEATURE_PAYMENT_CENTER=false
# 默认值：false；何时必填：启用统一收款且佣金余额两阶段协议、故障恢复及补偿验收后按需设为 true。
# 用途：服务端独立开关，允许同币种佣金支付；先预留、持久化权益准备、确认，再验证成功事件开通。
# 获取/生成：完成下单预留、本地权益准备及 Payment Center confirm/cancel/查询/退款联调后手动启用；未经验收保持 false。
FEATURE_COMMISSION_BALANCE=false
# 默认值：空；何时必填：启用统一收款、返佣或提现时。
# 用途：服务器访问 Payment Center 的服务地址，不是密钥；生产请求要求 HTTPS。
# 获取/生成：填写已有 Payment Center 的本地监听地址或已部署 HTTPS 根地址，不填旧链监听服务地址。
PAYMENT_CENTER_BASE_URL=
# 默认值：空；何时必填：FEATURE_PAYMENT_CENTER=true。
# 用途：服务端私密网站级下单/查询 Key，用于目录、订单、事件及订阅控制，不授予人工审批权限。
# 获取/生成：在 Payment Center 已有后台为本站独立 website 创建绑定的 create_order/query_order Key。
PAYMENT_CENTER_API_KEY=
# 默认值：空；何时必填：启用统一收款、返佣或提现时。
# 用途：非密钥的本站 website 代码，用于核对目录、返佣身份和签名连通挑战归属。
# 获取/生成：在 Payment Center 创建本站独立网站后，从网站记录或已认证目录响应复制 site_code。
PAYMENT_CENTER_SITE_CODE=
# 默认值：空；何时必填：启用统一收款、返佣或提现时。
# 用途：非密钥的本站 website ID，核对订单、回调、订阅和返佣响应归属；不要使用其他网站的 ID。
# 获取/生成：从 Payment Center 本站网站记录或已认证目录响应复制 website_id，与 SITE_CODE 属于同一网站。
PAYMENT_CENTER_WEBSITE_ID=
# 默认值：空；何时必填：FEATURE_PAYMENT_CENTER=true。
# 用途：服务端私密站点回调签名密钥，验证 Payment Center 发来的原始付款事件和连通挑战；不是 API Key。
# 获取/生成：从 Payment Center 本站 website 的独立回调密钥安全复制，至少 32 字符；不要填写 Stripe Webhook Secret。
PAYMENT_CENTER_CALLBACK_SIGNING_SECRET=
# 默认值：false；何时必填：本站返佣身份、规则、查询与恢复验收后按需设为 true。
# 用途：服务端邀请归因、用户同步和个人返佣查询开关，不提供团队邀请或成员管理。
# 获取/生成：在 Payment Center 既有返佣功能中配置本站规则及专用 Key，通过联调后手动启用。
FEATURE_REFERRALS=false
# 默认值：空；何时必填：FEATURE_REFERRALS=true，提现功能也依赖该 Key。
# 用途：服务端私密网站级 referral_read/referral_write Key，用于归因、用户同步及个人余额/流水查询。
# 获取/生成：在 Payment Center 为本站绑定专用返佣 Key，不授予 payment_ingest、人工审批或提现付款权限。
PAYMENT_CENTER_REFERRAL_API_KEY=
# 默认值：空；何时必填：FEATURE_REFERRALS=true 且要对付款入账/退款冲正结算返佣时。
# 用途：服务端私密网站级 payment_ingest Key，用于提交已签名的付款与退款返佣事件（/purchases 及其 refund）。
# 获取/生成：在 Payment Center 为本站绑定独立且仅授予 payment_ingest 的 Key，与 referral_read/下单 Key 分开。
PAYMENT_CENTER_PAYMENT_INGEST_API_KEY=
# 默认值：空；何时必填：FEATURE_REFERRALS=true 且要对付款入账结算返佣时。
# 用途：服务端私密付款入账 HMAC 密钥，与 Payment Center 返佣中心共享，签名 /purchases 及 refund 请求。
# 获取/生成：加密安全随机数生成 32 字节并编码为 Base64URL，同一值配置到返佣中心 REFERRAL_PAYMENT_INGEST_SECRET。
REFERRAL_PAYMENT_INGEST_SECRET=
# 默认值：false；何时必填：实际余额、最低金额、申请审批与结算验收后按需设为 true。
# 用途：服务端个人提现申请开关，依赖返佣、事务邮件、近期登录、邮箱确认、加密和独立提现凭据。
# 获取/生成：配齐相关变量并验收 Payment Center 流程后手动启用；审批及付款使用中心已有后台。
FEATURE_REFERRAL_WITHDRAWALS=false
# 默认值：空；何时必填：FEATURE_REFERRAL_WITHDRAWALS=true。
# 用途：服务端私密网站级 withdrawal_create Key，只提交授权用户的提现申请，不执行审批或付款。
# 获取/生成：在 Payment Center 为本站绑定独立且仅授予 withdrawal_create 的 Key，不复用下单 Key。
PAYMENT_CENTER_WITHDRAWAL_API_KEY=
# 默认值：空；何时必填：FEATURE_REFERRAL_WITHDRAWALS=true。
# 用途：服务端私密提现请求 HMAC 密钥，与 Payment Center 提现接口共享；与付款回调密钥分开。
# 获取/生成：使用加密安全随机数生成 32 字节并编码为 Base64URL，再将同一值配置到双方私有环境。
REFERRAL_WITHDRAWAL_REQUEST_SECRET=

# 默认值：false；何时必填：本站独立应用、联系人同步、授权保护及恢复任务验收后按需设为 true。
# 用途：服务端联系人、语言和营销意愿同步开关；活动邮件、退订及抑制由 Email Center 负责。
# 获取/生成：在 Email Center 已有后台建立本站应用，填齐服务端凭据并实际联调后手动启用。
FEATURE_EMAIL_CENTER=false
# 默认值：空；何时必填：启用联系人同步或公开订阅 Widget 时。
# 用途：Email Center 服务地址；同步由服务端访问，Widget 脚本来源会暴露给浏览器；生产要求 HTTPS。
# 获取/生成：填写已有 Email Center 的本地监听地址或已部署 HTTPS 根地址，并配置本站允许域名。
EMAIL_CENTER_URL=
# 默认值：空；何时必填：FEATURE_EMAIL_CENTER=true。
# 用途：服务端私密本站应用 Bearer Key，用于 contacts/upsert 与联系人查询对账，不进入浏览器。
# 获取/生成：在 Email Center“接入应用”创建本站独立应用时安全保存一次展示的服务端 API Key。
EMAIL_CENTER_API_KEY=
# 默认值：false；何时必填：本站公开 Widget Key、允许域名与浏览器行为验收后按需设为 true。
# 用途：独立的公开邮件订阅组件开关，当前在首页加载；不代替服务端联系人同步或认证邮件。
# 获取/生成：在 Email Center 本站应用中配置 Widget 与允许域名后手动启用，可独立于联系人开关配置。
FEATURE_EMAIL_CENTER_WIDGET=false
# 默认值：空；何时必填：FEATURE_EMAIL_CENTER_WIDGET=true。
# 用途：可公开给浏览器的本站应用 Widget Key，只用于公开订阅组件；不能当作服务端 Bearer Key。
# 获取/生成：从 Email Center 本站应用设置复制公开 Widget Key，确保允许域名包含本站访问来源。
NEXT_PUBLIC_EMAIL_CENTER_WIDGET_KEY=

# 默认值：false；何时必填：需要找回密码、邮箱确认/变更或提现等敏感操作前，配齐邮件凭据后启用。
# 用途：服务端事务邮件开关，仅发送用户主动请求的限时确认/重置链接；注册和登录不发送验证码。
# 获取/生成：配置独立 Resend 适配器并验证发件域名及投递后手动设为 true，不走 Email Center 活动邮件。
FEATURE_TRANSACTIONAL_EMAIL=false
# 默认值：空；何时必填：FEATURE_TRANSACTIONAL_EMAIL=true。
# 用途：服务端私密 Resend API Key，用于发送事务邮件；本地模拟测试凭据不能进入生产。
# 获取/生成：在 Resend 的 API Keys 创建用于本站发信的 Key，安全保存到私有环境。
RESEND_API_KEY=
# 默认值：空；何时必填：FEATURE_TRANSACTIONAL_EMAIL=true。
# 用途：事务邮件发件人地址，不是密钥；可使用 名称 <邮箱地址> 格式，域名须被邮件服务验证。
# 获取/生成：在 Resend 验证发件域名后，填写该域名下实际用于本站事务邮件的发件地址。
EMAIL_FROM=
# 默认值：空（使用 Resend 正式 API）；何时必填：仅本地模拟邮件 HTTP 测试需要，生产必须留空。
# 用途：服务端测试地址覆盖，不是凭据；生产代码禁止覆盖事务邮件 API 地址。
# 获取/生成：从本地模拟服务的监听配置取得，例如 http://127.0.0.1:4871/emails；真实投递无需填写。
# 默认值：空（使用 Resend 正式 API）；仅本地模拟邮件 HTTP 测试需要，生产必须留空。
# TRANSACTIONAL_EMAIL_API_URL=

# 默认值：manual；何时必填：上线前为各队列选择并验证 manual/cron/worker 的运行安排。
# 用途：非密钥的恢复调度模式；cron 开放受保护 HTTP 入口，manual/worker 不开放该入口。
# 获取/生成：本地默认手动执行 worker/reconcile；HTTP 调度设 cron；常驻 worker 需单独启动 npm run email:loop。
# 模式名不是 http；设置 worker 本身不会启动进程。该开关只管 HTTP 入口；
# 进程内的后台队列始终运行，不需要额外开关。
# 默认值：空（首次 setup 自动生成本地值）；何时必填：RECOVERY_RUNNER_MODE=cron。
# 用途：服务端私密 HTTP 调度 Bearer 密钥，保护 /api/internal/* 恢复入口；至少 32 字符。
# 获取/生成：本地由 npm run setup 生成；生产以加密安全随机数生成 32 字节 Base64URL 值，并配置给可信调度器。
CRON_SECRET=
# 默认值：v1；何时必填：启用提现账户加密时。
# 用途：非密钥的新数据加密版本，当前用于 AES-256-GCM 提现账户；不是自动定时轮换开关。
# 获取/生成：保持 v1；手动轮换前先在私有环境配置新版本密钥，旧数据清理前保留解密所需旧密钥。
# INTEGRATION_ENCRYPTION_ACTIVE_VERSION=v1
# 默认值：空（首次 setup 自动生成本地值）；何时必填：活动版本为 v1 且启用提现账户加密时。
# 用途：服务端私密 AES-256-GCM 密钥，必须为恰好 32 字节的规范 Base64 编码；用于加密和账户指纹。
# 获取/生成：本地由 npm run setup 生成；生产使用加密安全随机数生成 32 字节并编码为 Base64，安全保存且不擅自覆盖。
INTEGRATION_ENCRYPTION_KEY_V1=
# 默认值：30（天）；何时必填：可留默认，按自身数据保留要求调整。
# 用途：非密钥的成功任务敏感内容保留期；由 lib/jobs/retention.ts 读取、lib/jobs/maintenance.ts 执行。
# 获取/生成：无需生成。非法值（非整数、<=0、>36500）回落到默认值，因为"永久静默保留敏感载荷"正是该模块要避免的失败模式。
# 实际清理：清空已终结提现意图的 account_ciphertext；金额、状态、provider 编号等金融事实不设过期。
# COMPLETED_PAYLOAD_RETENTION_DAYS=30
# 默认值：90（天）；何时必填：可留默认，按故障恢复要求调整。
# 用途：非密钥的失败/人工复核任务敏感内容保留期，同样由 lib/jobs/retention.ts 读取并执行。
# 获取/生成：无需生成；非法值回落到默认 90。状态为 pending/sending/uncertain 的记录永不被清理。
# FAILED_PAYLOAD_RETENTION_DAYS=90
# 默认值：365（天）；何时必填：可留默认，按审计保留要求调整。
# 用途：非密钥的审计类临时记录保留期（已处理 inbox 事件、过期握手挑战）。
# 获取/生成：无需生成；非法值回落到默认 365。
# 执行入口：npm run maintenance（可加 --dry-run 预览），或由 npm run worker 与 CRON_SECRET 保护的 HTTP 调度执行；npm run dev 不会自动运行。
# AUDIT_RETENTION_DAYS=365
# 默认值：disabled（任何其他值都等同 disabled）；何时必填：仅在校验完"旧 provider 取消路径"后才设为 allowed。
# 用途：非密钥的跨支付渠道切换闸门，由 lib/subscription/manager.ts::providerSwitchAllowed() 读取；只认字面量 allowed。
# 获取/生成：无需生成。刻意用环境变量而非请求字段，避免调用方自行选择加入；旧渠道取消未验证前保持 disabled。
# SUBSCRIPTION_PROVIDER_SWITCH=disabled
# 默认值：enforce（只有字面量 off 会关掉）；何时必填：不需要设置，留空即可。
# 用途：付费门槛的应急闸刀，由 lib/subscription/access.ts::subscriptionGateEnabled() 读取。正常时只要 Payment Center 配置齐全就要求有效订阅；
#       支付中心故障、回调积压时设为 off 可立即放行所有账号，不需要重新部署。
# 获取/生成：无需生成。改回 enforce（或删除本行）即恢复收费门槛。
# SUBSCRIPTION_ENFORCEMENT=off
# 默认值：空；何时必填：可选，给开发者或客服账号留口子。
# 用途：逗号分隔的邮箱白名单，不区分大小写；命中的账号跳过订阅检查。只读环境变量，不接受请求传入。
# 获取/生成：手填邮箱，多个用英文逗号分隔；不要提交真实邮箱到仓库。
# SUBSCRIPTION_EXEMPT_EMAILS=
